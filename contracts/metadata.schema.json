{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "hooklab.index.v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "module_id",
              "version",
              "sha256",
              "size"
            ]
          }
        }
      },
      "required": [
        "schema",
        "revision",
        "modules"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "hooklab.module.manifest.v1"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
        },
        "sdk_min": {
          "const": 1
        },
        "sdk_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "api": {
          "const": 102
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^com\\.mikeyphw\\.hooklab\\.modules\\.[a-z][a-z0-9_]{0,63}\\.[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
              },
              "package": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
              },
              "min_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "max_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "id",
              "package",
              "min_version",
              "max_version"
            ]
          }
        }
      },
      "required": [
        "schema",
        "module_id",
        "version",
        "sdk_min",
        "sdk_max",
        "api",
        "entrypoint",
        "hooks"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "hooklab.module.receipt.v1"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "STAGED",
            "VERIFIED",
            "READY",
            "ACTIVE",
            "FAILED",
            "ROLLED_BACK"
          ]
        }
      },
      "required": [
        "schema",
        "module_id",
        "version",
        "source_sha",
        "source_tree",
        "sha256",
        "state"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "hooklab.settings.v1"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "flags": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "schema",
        "module_id",
        "generation",
        "flags"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/index"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/settings"
    }
  ]
}
