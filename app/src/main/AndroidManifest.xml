<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Explicit visibility only for the three host packages and ObtainX destination. -->
    <queries>
        <package android:name="br.art.code.meucronogramacapilar" />
        <package android:name="com.machiav3lli.fdroid" />
        <package android:name="com.looker.droidify" />
        <package android:name="dev.bikram.obtainx" />
    </queries>
    <application android:name=".HookLabApp" android:allowBackup="false"
        android:label="@string/app_name" android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher" android:theme="@style/Theme.HookLab"
        android:supportsRtl="true">
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".mcc.MccControlActivity" android:exported="true" />
        <provider android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" android:directBootAware="true" />
    </application>
</manifest>
